# ---------------------------------------------------------------------------
# The Retail Packaging — environment variables
# Copy to .env.local for development, or set in the Vercel dashboard for prod.
# NEVER commit real values. This file holds placeholders only.
# ---------------------------------------------------------------------------

# --- SMTP: required for the quote form to deliver email ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Where quote requests are delivered, and the visible sender address.
QUOTE_TO_EMAIL=info@theretailpackaging.com
QUOTE_FROM_EMAIL=noreply@theretailpackaging.com

# --- Analytics (optional) ---
# Leave blank to ship with no analytics. No script loads without a real ID.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_GSC_VERIFICATION=
