---
import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import CtaBand from '../../components/CtaBand.astro'
import Faqs from '../../components/Faqs.astro'
import { states, cities } from '../../data/locations'
import { SITE } from '../../lib/site'
import * as S from '../../lib/schema'

const path = '/locations/'
const title = 'Custom Packaging Across the United States | Locations'
const description = 'We manufacture custom packaging to order and ship to all 50 states. Find delivery guidance and sector notes for 20 states and 20 major US cities.'
const trail = [{ name: 'Home', url: '/' }, { name: 'Locations', url: path }]

const faqs = [
  { q: 'Which US states do you ship packaging to?', a: 'All fifty. The pages listed here cover the twenty states and twenty cities where we see the most demand, but production and shipping work the same way for any US address.' },
  { q: 'Do you have local offices or factories?', a: 'No. We manufacture through production partners and ship directly to you. We do not claim local addresses or local teams in cities where we do not have them.' },
  { q: 'Does my location change the price of the packaging?', a: 'The packaging itself is priced on format, size, material, printing and quantity. Location only affects freight, which we quote separately based on consignment size and destination.' },
  { q: 'How long does delivery take across the US?', a: 'Ground transit typically runs 2 to 7 business days depending on distance, on top of 8 to 15 business days of production after artwork approval. Every quote carries a confirmed timeline.' },
  { q: 'Can you deliver to more than one address?', a: 'Yes. A single production run can be split across several delivery points, which suits brands with multiple stores or fulfilment centres. Tell us the split at quoting so freight is costed properly.' },
  { q: 'Do you deliver to Alaska and Hawaii?', a: 'Yes, though transit takes longer and freight costs more than the contiguous states. We quote those routes individually rather than applying a standard rate.' },
  { q: 'Can you ship straight to a third-party fulfilment centre?', a: 'Yes, and it is common. Send us the receiving requirements — most 3PLs have specific labelling, pallet height and booking rules that we need before dispatch.' },
  { q: 'Do regional regulations change the packaging specification?', a: 'Sometimes. California Proposition 65 warnings and state-level cannabis labelling rules are the two that come up most. Tell us where the product will be sold and we will leave panel space for what you need.' },
  { q: 'Does climate affect what you recommend?', a: 'It does. Sustained heat softens some adhesives, and humidity reduces the rigidity of uncoated board. For warm or humid storage we specify heat-stable laminates and moisture-resistant coatings.' },
  { q: 'How do I start an order from my location?', a: `Send a quote request with your product dimensions, quantity and deadline, or call ${SITE.phone}. We reply with a specification, a lead time and a written price.` },
]

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description, type: 'CollectionPage' }),
  S.breadcrumbs(path, trail),
  S.itemList(path, [...states, ...cities].map((p) => ({ name: p.name, url: `/locations/${p.slug}/` }))),
  S.faqPage(path, faqs),
])
---
<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />
  <section class="hub-hero">
    <div class="wrap">
      <p class="eyebrow">United States</p>
      <h1>Custom packaging delivered across the US</h1>
      <p class="lede">
        We manufacture to order and ship nationwide. The pages below cover the states and cities
        where we see the most demand, with the sector mix, freight reality and one specification
        note that genuinely applies to each place.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>States</h2>
      <ul class="place-grid" role="list">
        {states.map((p) => (
          <li><a href={`/locations/${p.slug}/`}><span class="pn">{p.name}</span><span class="ps">{p.sectors[0]}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="wrap">
      <h2>Cities</h2>
      <ul class="place-grid" role="list">
        {cities.map((p) => (
          <li><a href={`/locations/${p.slug}/`}><span class="pn">{p.name}</span><span class="ps">{p.state}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Faqs faqs={faqs} title="Delivery and coverage questions" />
  <CtaBand />
</Base>

<style>
  .hub-hero { background: linear-gradient(180deg,var(--bone),var(--bone-deep)); border-bottom:1px solid var(--border);
    padding-block: clamp(1.5rem,1rem + 2vw,3rem) clamp(2.5rem,2rem + 3vw,4rem); }
  .hub-hero .lede { margin-top: var(--s-5); }
  .place-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(210px,100%),1fr)); gap:var(--s-3); margin-top:var(--s-8); padding:0; }
  .place-grid a { display:flex; flex-direction:column; gap:.2rem; padding:var(--s-4); background:var(--paper);
    border:1px solid var(--border); border-radius:var(--r-md); text-decoration:none;
    transition:border-color var(--dur) var(--ease), transform var(--dur) var(--ease); min-height:44px; }
  .place-grid a:hover { border-color:var(--accent); transform:translateY(-2px); }
  .pn { font-weight:600; color:var(--ink); font-size:var(--fs-sm); }
  .ps { font-size:var(--fs-xs); color:var(--text-faint); }
</style>
