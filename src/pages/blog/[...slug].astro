---
import type { GetStaticPaths } from 'astro'
import { getCollection, render } from 'astro:content'
import ArticleLayout from '../../templates/ArticleLayout.astro'

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog')
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }))
}) satisfies GetStaticPaths

const { post } = Astro.props
const { Content, headings } = await render(post)
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0
const path = `/blog/${post.id}/`
---
<ArticleLayout data={post.data} section="blog" sectionName="Packaging blog" path={path} wordCount={wordCount} headings={headings} faqs={post.data.faqs}>
  <Content />
</ArticleLayout>
