---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Faqs from '../components/Faqs.astro'
import QuickSpec from '../components/QuickSpec.astro'
import CtaBand from '../components/CtaBand.astro'
import { categories, productsIn } from '../lib/catalog'
import { SITE } from '../lib/site'
import * as S from '../lib/schema'

const path = '/custom-packaging-tool/'
const title = 'Custom Packaging Design Tool | Build a Specification'
const description = 'Configure box style, dimensions, material, printing, colours, finish and add-ons, then send the full specification with your quote request.'
const trail = [{ name: 'Home', url: '/' }, { name: 'Packaging design tool', url: path }]

const catOptions = categories
  .map((c) => ({ ...c, count: productsIn(c.slug).length }))
  .sort((a, b) => a.name.localeCompare(b.name))

const styles = [
  'Reverse tuck end carton', 'Straight tuck end carton', 'Auto-lock bottom carton',
  'Roll-end tuck front mailer', 'Regular slotted shipper', 'Rigid two-piece box',
  'Rigid hinged lid box', 'Sleeve and tray', 'Display case with tear-away front',
  'Locking-corner tray', 'Stand-up pouch', 'Flat pouch', 'Paper bag with handles',
  'Pressure-sensitive label', 'Die-cut sticker', 'Not sure — advise me',
]
const materials = [
  '12pt SBS paperboard', '14pt SBS paperboard', '16pt SBS paperboard', '18pt SBS paperboard',
  'Kraft board', 'Recycled CCNB board', 'E-flute corrugated', 'B-flute corrugated',
  'BC double-wall corrugated', 'Rigid greyboard 1.5mm', 'Rigid greyboard 2mm',
  'Laminated barrier film', 'Recyclable mono-PE film', 'Certified compostable film',
  'Not sure — advise me',
]
const printing = ['Digital press', 'Offset lithography', 'Flexography', 'Screen printing', 'Unprinted', 'Not sure — advise me']
const finishes = ['Matte lamination', 'Gloss lamination', 'Soft-touch lamination', 'Aqueous coating', 'Spot UV', 'Foil stamping', 'Embossing', 'Uncoated / none']
const coatings = ['None', 'Aqueous', 'UV', 'Grease-resistant', 'Moisture-resistant', 'Not sure — advise me']
const swatches = [
  { n: 'Natural kraft', v: '#c8a97e' }, { n: 'White', v: '#f7f5f1' },
  { n: 'Charcoal', v: '#22262b' }, { n: 'Forest green', v: '#14432f' },
  { n: 'Deep navy', v: '#1b2a44' }, { n: 'Burgundy', v: '#5c1f28' },
  { n: 'Champagne', v: '#b08d46' }, { n: 'Terracotta', v: '#a8563b' },
  { n: 'Sage', v: '#8a9a82' }, { n: 'Black', v: '#14161a' },
]

const faqs = [
  { q: 'Does this tool give me a price?', a: 'No. It builds a specification and sends it with your quote request. We do not display an instant price because a verified pricing formula that accounts for size, board, print, finishing and quantity does not reduce to a calculator without misleading you.' },
  { q: 'Do I have to complete every step?', a: 'No. Anything you are unsure about can be left as "advise me" and we will recommend an option. The dimensions and quantity are the two that matter most.' },
  { q: 'Is the 3D preview an accurate render of my box?', a: 'It is a visual approximation showing proportions, colour and finish character. It is not a colour-accurate proof. For that, ask for a printed prototype on the actual substrate.' },
  { q: 'Will my configuration be saved?', a: 'Yes, in your own browser using local storage. Nothing is sent to us until you submit the form, and clearing your browser data removes it.' },
  { q: 'Can I upload artwork through the tool?', a: 'Yes. Up to five files of 10 MB each in PDF, AI, EPS, SVG, PNG, JPG, WEBP or ZIP.' },
  { q: 'Can I use the tool on a phone?', a: 'Yes. On smaller screens it becomes a step-by-step flow rather than a single long form, and every control is reachable by keyboard.' },
  { q: 'What happens after I submit?', a: 'Your full configuration arrives with our team alongside your contact details and any artwork. We reply with a specification, a lead time and a written price, usually within one business day.' },
  { q: 'What if my requirement is not in the options?', a: 'Describe it in the additional instructions field. The option lists cover common cases, not every possible structure.' },
  { q: 'Can I change the specification after submitting?', a: 'Yes. Nothing is committed until you approve a quote, and changes before production cost nothing beyond a reissued price.' },
  { q: 'How accurate do my dimensions need to be?', a: 'As accurate as you can manage — measure the product at its widest point in the state it will be packed. If you only have an approximation, say so and we will confirm before tooling.' },
]

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description }),
  S.breadcrumbs(path, trail),
  S.faqPage(path, faqs),
])
---

<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />

  <section class="tool-hero">
    <div class="wrap">
      <p class="eyebrow">Specification builder</p>
      <h1>Build Your Packaging Specification</h1>
      <p class="lede">
        Every choice on one screen — no steps to click through. Set what you know, leave the rest,
        and send it over. Anything you skip comes back as a recommendation.
      </p>
    </div>
  </section>

  <QuickSpec
    variant="panel"
    title="Your specification"
    intro="Chips below cover the decisions that change a quote. Nothing here calculates a price — your configuration goes to our team and comes back priced."
  />

  <Faqs faqs={faqs} title="Packaging Tool Questions" />
  <CtaBand title="Prefer to Describe It in Your Own Words?" text="Skip the builder and send us a plain description of what you are packing. We will come back with a specification." />
</Base>

<style>
  .tool-hero { padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem); }
  .tool-hero h1 { font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4rem); max-width: 18ch; }
  .tool-hero .lede { margin-top: var(--s-5); }
</style>
