---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Faqs from '../components/Faqs.astro'
import { SITE, whatsappUrl } from '../lib/site'
import * as S from '../lib/schema'

const path = '/contact-us/'
const title = 'Contact The Retail Packaging | Talk to a Specifier'
const description = 'Reach us by phone, email or WhatsApp for custom packaging enquiries, specification advice, artwork questions or an update on an existing order.'
const trail = [{ name: 'Home', url: '/' }, { name: 'Contact us', url: path }]

const faqs = [
  { q: 'What is the fastest way to reach you?', a: `Phone on ${SITE.phone} in the US or ${SITE.phoneUk} in the UK, or WhatsApp for a quick question. Email and the form are answered within one business day.` },
  { q: 'Who will I be speaking to?', a: 'A specifier who can discuss structure, material and print, not a call handler passing a message along. The same person then handles your quote, proof and production.' },
  { q: 'Can you help before I know what I need?', a: 'Yes, and that is a common starting point. Describe the product and how it sells, and we will suggest formats worth considering.' },
  { q: 'How do I check on an existing order?', a: 'Reply to your quote email or call with the reference number. We can tell you where the job is in production and whether the date is still firm.' },
  { q: 'Do you have a physical address for visits?', a: 'We do not run public facility visits. For large programmes we can arrange a production review with the relevant partner facility.' },
  { q: 'Can I send artwork by email?', a: 'Yes, for files under 20 MB. Anything larger is better sent as a download link, or uploaded through the quote form.' },
  { q: 'Do you work with agencies?', a: 'Yes. We can work directly with an agency on behalf of a client, including supplying dielines and technical specifications for design work.' },
  { q: 'Do you handle enquiries from outside the US?', a: 'Yes. We supply brands in the United Kingdom, Canada and Australia as well as the United States, on identical terms — same specification process, same 100-unit minimum, same 3 to 5 day production and 5 to 7 day transit. Only the freight cost changes, and we work that out per consignment.' },
  { q: 'How quickly will I hear back?', a: 'Within one business day for quotes and specification questions. If a requirement needs a structural mock-up before we can price it accurately, we tell you that rather than leaving you waiting on a number we cannot yet give.' },
  { q: 'How do I make a complaint?', a: 'Contact us directly with your order reference and what went wrong. If an order does not match the approved specification we will put it right.' },
]

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description, type: 'ContactPage' }),
  S.breadcrumbs(path, trail),
  S.faqPage(path, faqs),
])
---
<Base title={title} description={description} path={path} schema={schema}>
  <Breadcrumbs trail={trail} />
  <section class="section">
    <div class="wrap c-grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Talk to someone who specifies packaging</h1>
        <p class="lede">
          Whether you know exactly what you need or are still working out the format, the
          conversation starts the same way — what are you packing, and where does it have to survive.
        </p>
        <dl class="contact-list">
          <div><dt>Phone (US)</dt><dd><a href={SITE.phoneHref} data-analytics="phone-click">{SITE.phone}</a></dd></div>
          <div><dt>Phone (UK)</dt><dd><a href={SITE.phoneUkHref} data-analytics="phone-click">{SITE.phoneUk}</a></dd></div>
          <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
          <div><dt>WhatsApp</dt><dd><a href={whatsappUrl()} target="_blank" rel="noopener noreferrer" data-analytics="whatsapp-click">{SITE.whatsappDisplay}</a></dd></div>
          <div><dt>Coverage</dt><dd>United States, United Kingdom, Canada, Australia</dd></div>
        </dl>
        <p class="muted small">
          We do not operate walk-in premises. For an update on an existing order, quote your
          reference number and we can tell you where the job sits in production.
        </p>
      </div>
      <QuoteForm id="quote" variant="short" source="contact-page" title="Send us a message"
        intro="Use this for any enquiry — a quote, a specification question, or an update on an existing order." />
    </div>
  </section>
  <Faqs faqs={faqs} title="Contact questions" />
</Base>
<style>
  .c-grid { display:grid; grid-template-columns:minmax(0,0.9fr) minmax(0,1.1fr); gap:clamp(2rem,1rem + 4vw,4rem); align-items:start; }
  @media (max-width:980px){ .c-grid{ grid-template-columns:1fr; } }
  .c-grid .lede { margin-top:var(--s-5); }
  .contact-list { margin:var(--s-8) 0 var(--s-5); display:grid; gap:0; }
  .contact-list > div { display:grid; grid-template-columns:minmax(110px,28%) 1fr; gap:var(--s-4);
    padding:.7rem 0; border-bottom:1px solid var(--border); font-size:var(--fs-sm); }
  .contact-list dt { font-weight:600; color:var(--ink); }
  .contact-list dd { margin:0; color:var(--text-muted); }
</style>
