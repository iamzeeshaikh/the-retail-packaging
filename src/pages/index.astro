---
import Base from '../layouts/Base.astro'
import CategoryCard from '../components/CategoryCard.astro'
import ProductCard from '../components/ProductCard.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Faqs from '../components/Faqs.astro'
import CtaBand from '../components/CtaBand.astro'
import { categories, products, productsIn, bySlug, categoryHero, totals } from '../lib/catalog'
import { INDUSTRIES } from '../lib/taxonomy'
import { SITE } from '../lib/site'
import * as S from '../lib/schema'

const path = '/'

const get = (s: string) => bySlug.get(s)
const cat = (s: string) => {
  const c = categories.find((x) => x.slug === s)!
  return { c, list: productsIn(s) }
}

/* Hero: two large photo tiles, the noissue opening, using our own photography. */
const heroA = cat('custom-mailers')
const heroB = cat('custom-cosmetic-packaging')
const heroImgA = categoryHero(heroA.c.slug)?.images?.[0]
const heroImgB = categoryHero(heroB.c.slug)?.images?.[0]

const featured = ['custom-mailers', 'custom-food-packaging', 'custom-cosmetic-packaging',
  'custom-bags', 'custom-pouches', 'custom-labels', 'custom-display-boxes', 'custom-printed-cups']
  .map((s) => cat(s))

const railSlugs = ['mailer-boxes', 'cosmetic-boxes', 'candle-boxes-with-window', 'kraft-paper-bags',
  'stand-up-pouches', 'custom-die-cut-stickers', 'soap-display-boxes', 'rigid-boxes-with-inserts',
  'coffee-cups', 'chocolate-boxes']
const rail = railSlugs.map(get).filter(Boolean) as NonNullable<ReturnType<typeof get>>[]

const lowMin = products
  .filter((p) => ['sticker', 'label', 'rigid-box', 'mailer', 'tote-bag'].includes(p.form.id))
  .filter((p) => p.images.length >= 4)
  .slice(0, 8)

const industryTiles = [
  { i: INDUSTRIES.food, slug: 'custom-food-packaging', sample: 'burger-boxes' },
  { i: INDUSTRIES.beauty, slug: 'custom-cosmetic-packaging', sample: 'lipstick-boxes' },
  { i: INDUSTRIES.ecommerce, slug: 'custom-mailers', sample: 'bubble-mailers' },
  { i: INDUSTRIES.home, slug: 'custom-candle-packaging', sample: 'candle-jar-boxes' },
]

const faqs = [
  { q: 'What does The Retail Packaging actually make?', a: `We manufacture custom retail packaging to order — ${totals.products} formats across ${totals.categories} categories, covering folding cartons, rigid boxes, corrugated mailers, paper bags, pouches, labels, sleeves, trays and retail displays. Everything is cut to your dimensions rather than pulled from a stock catalogue.` },
  { q: 'How much does custom packaging cost?', a: `${SITE.priceLine} A small run of digitally printed cartons and a 50,000-unit flexo run sit at opposite ends of that range, which is why we quote each project rather than publishing a price list.` },
  { q: 'What is the minimum order quantity?', a: 'It depends on the format and the printing route. Digital printing starts as low as 50 pieces for stickers and 100 for mailer boxes. Offset and flexo runs need larger quantities to absorb the plate cost, usually from 1,000 units. Tell us your quantity and we will quote the most efficient way to produce it.' },
  { q: 'How long does production take?', a: 'Most orders move through production in 8 to 15 business days once artwork is approved, with shipping on top. Hand-assembled rigid boxes and specialty finishes sit at the longer end. We confirm a firm date in writing with every quote.' },
  { q: 'Can I get a sample before committing to a full run?', a: 'Yes. We can produce a plain structural sample so you can check that your product actually fits, or a printed prototype so you can judge colour and finish. Sample costs are normally credited against the production order that follows.' },
  { q: 'What artwork files do you need?', a: 'A print-ready PDF or vector AI file works best, with fonts outlined, images at 300 dpi and CMYK colour. We send you a dieline template for your chosen size, and our prepress team checks every file before it goes to press.' },
  { q: 'Do you help if I do not have artwork yet?', a: 'Yes. Our design team can build packaging artwork from a logo and a brand direction, or adapt existing artwork onto a new dieline. Tell us what you have and we will tell you what is missing.' },
  { q: 'Which materials can I choose from?', a: 'Paperboard, kraft board, corrugated, rigid greyboard, laminated barrier films, recycled grades and certified compostable stocks. The right choice depends on the weight of your product, how it ships and any food-contact requirement.' },
  { q: 'Do you ship across the United States?', a: 'Yes, we ship nationwide. Delivery time varies by destination and consignment size, and we confirm the window when your order is approved for production.' },
  { q: 'Can you produce recyclable or compostable packaging?', a: 'Most of our formats can be produced on recycled board or with recyclable materials, and several can be made certified compostable. Recycled content, kerbside recyclability and compostability are three different claims, so tell us which one you need to support and we will specify a material that genuinely backs it.' },
  { q: 'Do you print on the inside of boxes?', a: 'Yes, interior printing is available on mailer boxes, folding cartons and rigid boxes. It is most worth the cost when the product does not fill the box, because that is when the customer actually sees the inside face at opening.' },
  { q: 'How do I start an order?', a: 'Send a quote request with your product dimensions, the quantity you need and your deadline. We reply with a specification, a lead time and a written price, usually within one business day.' },
]

const title = 'Custom Retail Packaging Manufacturer | US Made to Order'
const description = 'Custom retail packaging built to your dimensions — boxes, bags, pouches, labels and displays. Printing, finishing and US delivery from one supplier.'

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description, image: heroImgA ? `${heroImgA.base}-1400.webp` : undefined }),
  S.breadcrumbs(path, [{ name: 'Home', url: '/' }]),
  S.faqPage(path, faqs),
])
---

<Base
  title={title} description={description} path={path}
  image={heroImgA ? `${heroImgA.base}-1400.webp` : undefined}
  imageAlt="Custom printed mailer boxes produced by The Retail Packaging"
  schema={schema}
  preloadImage={heroImgA ? {
    href: `${heroImgA.base}-1400.webp`,
    srcset: `${heroImgA.base}-800.webp 800w, ${heroImgA.base}-1400.webp 1400w`,
    sizes: '(max-width: 900px) 96vw, 48vw',
  } : undefined}
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-top">
        <div class="hero-copy">
          <p class="eyebrow">Made to order · United States</p>
          <h1>Packaging built around your product</h1>
        </div>
        <div class="hero-aside">
          <p class="hero-sub">
            {totals.categories} categories, {totals.products} formats, no stock sizes. Send the
            dimensions and the quantity; we return a specification, a lead time and a written price.
          </p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/request-a-quote/">Request a quote</a>
            <a class="btn btn-outline" href="/custom-packaging-tool/">Build a specification</a>
          </div>
        </div>
      </div>

      <div class="hero-tiles">
        <a class="tile-photo hero-tile" href={heroA.c.url}>
          {heroImgA && (
            <img src={`${heroImgA.base}-1400.webp`}
              srcset={`${heroImgA.base}-800.webp 800w, ${heroImgA.base}-1400.webp 1400w`}
              sizes="(max-width: 900px) 96vw, 62vw"
              width={heroImgA.width} height={heroImgA.height}
              alt="Custom printed mailer boxes with full-colour exterior artwork"
              fetchpriority="high" decoding="async" />
          )}
          <span class="tile-copy">
            <span class="k">{heroA.list.length} formats</span>
            <span class="tt">{heroA.c.name}</span>
            <span class="sub">Roll-end tuck, interior print, tape-free assembly</span>
          </span>
        </a>

        <a class="tile-photo hero-tile hero-tile-sm" href={heroB.c.url}>
          {heroImgB && (
            <img src={`${heroImgB.base}-800.webp`}
              srcset={`${heroImgB.base}-400.webp 400w, ${heroImgB.base}-800.webp 800w`}
              sizes="(max-width: 900px) 96vw, 34vw"
              width={heroImgB.width} height={heroImgB.height}
              alt="Custom cosmetic cartons printed with brand artwork"
              loading="eager" decoding="async" />
          )}
          <span class="tile-copy">
            <span class="k">{heroB.list.length} formats</span>
            <span class="tt">{heroB.c.name}</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP (only verifiable claims) ============ -->
  <div class="trust">
    <div class="wrap trust-in">
      <span>Made to order, never stock</span>
      <span>{totals.products} formats in production</span>
      <span>Written specification with every price</span>
      <span>Delivery to all 50 states</span>
      <span>From $0.30 per piece at volume</span>
    </div>
  </div>

  <!-- ============ LOW MINIMUM RAIL ============ -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Short runs</p>
          <h2>Low minimum, quick turnaround</h2>
        </div>
        <a class="sec-link" href="/sitemap/">All {totals.products} formats</a>
      </div>
      <div class="rail rail-bleed">
        {lowMin.map((p, i) => <ProductCard product={p} loading={i < 4 ? 'eager' : 'lazy'} showCategory />)}
      </div>
    </div>
  </section>

  <!-- ============ CATEGORY TILES ============ -->
  <section class="section section-sunken">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Categories</p>
          <h2>Eight ranges that carry most of the volume</h2>
        </div>
        <a class="sec-link" href="/sitemap/">All {totals.categories} categories</a>
      </div>
      <div class="cat-grid">
        {featured.map(({ c, list }, i) => (
          <div class={`reveal reveal-d${i % 4}`}>
            <CategoryCard category={c} count={list.length} sample={categoryHero(c.slug)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ INDUSTRY ============ -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">By industry</p>
          <h2>What you sell decides the specification</h2>
        </div>
      </div>
      <p class="lede" style="margin-bottom:var(--s-10)">
        A candle, a supplement bottle and a folded shirt have almost nothing in common as packaging
        problems. These are the four sectors we quote most, and what actually drives each one.
      </p>
      <div class="ind-grid">
        {industryTiles.map((x, i) => {
          const c = categories.find((k) => k.slug === x.slug)!
          const s = categoryHero(x.slug) ?? get(x.sample)
          return (
            <a class={`ind reveal reveal-d${i % 4}`} href={c.url}>
              <div class="ind-media">
                {s?.images?.[0] && (
                  <img src={`${s.images[0].base}-400.webp`}
                    srcset={`${s.images[0].base}-400.webp 400w, ${s.images[0].base}-800.webp 800w`}
                    sizes="(max-width:620px) 92vw, 300px"
                    width={s.images[0].width} height={s.images[0].height}
                    loading="lazy" decoding="async"
                    alt={`${s.name} produced for ${x.i.name.toLowerCase()} brands`} />
                )}
              </div>
              <div class="ind-body">
                <h3>{x.i.name}</h3>
                <p>{x.i.blurb}</p>
                <span class="ind-go">{c.name} — {productsIn(x.slug).length} formats</span>
              </div>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <!-- ============ FREQUENTLY SPECIFIED RAIL ============ -->
  <section class="section section-sunken">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Frequently specified</p>
          <h2>Formats buyers ask for most</h2>
        </div>
      </div>
      <div class="rail rail-bleed">
        {rail.map((p) => <ProductCard product={p} showCategory />)}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">How it works</p>
        <h2>Six stages, no surprises</h2>
        <p class="lede">
          The only variable is how long each stage takes, and that depends almost entirely on how
          complete the information is at the start.
        </p>
        <a class="btn btn-outline" href="/how-it-works/" style="margin-top:var(--s-8)">The full process</a>
      </div>
      <div class="steps">
        {[
          { h: 'Requirement', d: 'Dimensions, weight, quantity, deadline, destination.' },
          { h: 'Specification and quote', d: 'Board grade, structure, print method, lead time, written price.' },
          { h: 'Dieline', d: 'A template cut to your product, not a stock rectangle.' },
          { h: 'Prepress and proof', d: 'Bleed, resolution, fonts and cut lines checked before plate.' },
          { h: 'Production', d: 'Print, die-cut, finish and assemble. 8 to 15 business days.' },
          { h: 'Delivery', d: 'Flat or assembled, to one address or split across sites.' },
        ].map((x) => (
          <div class="step reveal">
            <h3 class="step-h">{x.h}</h3>
            <p class="muted small">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ SUSTAINABILITY ============ -->
  <section class="section section-sand">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Materials</p>
        <h2>Claims you can defend</h2>
        <p class="lede">
          Recycled content, kerbside recyclability and certified compostability are three separate
          claims with three separate evidence requirements. Brands get into trouble by treating them
          as one.
        </p>
        <p class="muted">
          Tell us which claim you intend to print on the pack and we specify a material that supports
          it — or say plainly that it does not exist at your price point. Our
          {' '}<a href="/resources/sustainable-packaging-guide/">comparison of sustainable packaging materials</a>
          {' '}sets out where each option falls short.
        </p>
        <a class="btn btn-outline" href="/sustainability/" style="margin-top:var(--s-8)">Our approach</a>
      </div>
      <div>
        <div class="table-scroll">
          <table class="data">
            <caption>Environmental options and what they really cost</caption>
            <thead><tr><th scope="col">Option</th><th scope="col">Cost vs conventional</th><th scope="col">Recovery route</th></tr></thead>
            <tbody>
              <tr><th scope="row">Recycled paperboard</th><td>0–5% higher</td><td>Kerbside, widely accepted</td></tr>
              <tr><th scope="row">Aqueous coating</th><td>Broadly neutral</td><td>Keeps paper recyclable</td></tr>
              <tr><th scope="row">Mono-material film</th><td>10–20% higher</td><td>Store drop-off only</td></tr>
              <tr><th scope="row">Certified compostable</th><td>20–40% higher</td><td>Industrial facilities only</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="section section-sunken">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Get a price</p>
        <h2>Tell us what you are packing</h2>
        <p class="lede">
          Most quotes go back the same working day. If your requirement needs a structural mock-up
          first, we say so instead of guessing at a number.
        </p>
        <ul class="tick-list" style="margin-top:var(--s-6)">
          <li>No obligation and no account required</li>
          <li>Written specification with every price</li>
          <li>Artwork upload up to five files</li>
        </ul>
        <p class="muted small" style="margin-top:var(--s-6)">{SITE.priceLine}</p>
      </div>
      <QuoteForm id="home-quote" source="homepage" title="Request a quote" />
    </div>
  </section>

  <Faqs faqs={faqs} title="Questions buyers ask first" />

  <CtaBand />
</Base>

<style>
  /* ---------- hero ---------- */
  .hero { padding-block: clamp(2rem, 1.4rem + 2.5vw, 4rem) clamp(2rem, 1.5rem + 2vw, 3.5rem); }

  /* Headline left, supporting copy and actions right — the full width is used,
     and the h1 is never squeezed into a narrow column that breaks words. */
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: end;
    padding-bottom: clamp(1.75rem, 1.2rem + 2vw, 3rem);
  }
  @media (max-width: 900px) { .hero-top { grid-template-columns: 1fr; align-items: start; gap: var(--s-6); } }

  .hero h1 {
    font-size: clamp(2.4rem, 1.2rem + 5.4vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: 18ch;
    text-wrap: balance;
    hyphens: none;
    overflow-wrap: normal;
  }
  .hero-sub { font-size: var(--fs-md); color: var(--text-muted); max-width: 46ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  /* Asymmetric pair — a lead tile and a secondary, rather than two equal halves. */
  .hero-tiles {
    display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
    gap: var(--s-3); align-items: stretch;
  }
  @media (max-width: 780px) { .hero-tiles { grid-template-columns: 1fr; } }
  /* The lead tile sets the height; the secondary stretches to match it, so the
     pair reads as one band rather than two misaligned rectangles. */
  .hero-tile { aspect-ratio: 16 / 10; }
  .hero-tile-sm { aspect-ratio: auto; height: 100%; }
  @media (max-width: 780px) {
    .hero-tile { aspect-ratio: 3 / 2; }
    .hero-tile-sm { aspect-ratio: 3 / 2; height: auto; }
  }
  .hero-tile img { width: 100%; height: 100%; object-fit: cover; }
  .tile-copy .tt {
    display: block; margin-top: var(--s-2);
    font-family: var(--font-display); font-weight: 500;
    font-size: var(--fs-xl); line-height: 1.05; letter-spacing: -0.03em; color: #fff;
  }
  .tile-copy .sub { display: block; margin-top: var(--s-2); font-size: var(--fs-sm); color: rgba(255,255,255,.82); }

  /* ---------- trust ---------- */
  .trust { background: var(--ink-deep); color: rgba(247,243,236,.72); }
  .trust-in {
    display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-8);
    padding-block: var(--s-4);
    font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase;
  }

  /* ---------- section heads ---------- */
  .sec-head {
    display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between;
    gap: var(--s-5); margin-bottom: var(--s-8);
    border-top: 1px solid var(--ink); padding-top: var(--s-5);
  }
  .sec-head h2 { font-size: var(--fs-2xl); }
  .sec-link {
    font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--rule-strong);
    padding-bottom: 2px; white-space: nowrap;
  }
  .sec-link:hover { color: var(--ox); border-color: var(--ox); }

  /* ---------- category grid ---------- */
  .cat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(1rem, 0.6rem + 1.4vw, 2rem) var(--s-4); }
  @media (max-width: 1024px) { .cat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px)  { .cat-grid { grid-template-columns: 1fr; } }

  /* ---------- industry ---------- */
  .ind-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
  @media (max-width: 1024px) { .ind-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px)  { .ind-grid { grid-template-columns: 1fr; } }
  .ind {
    display: flex; flex-direction: column; text-decoration: none; color: inherit;
    background: var(--paper); border: 1px solid var(--border); border-radius: var(--r-lg);
    overflow: hidden; transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .ind:hover { border-color: var(--rule-strong); transform: translateY(-2px); color: inherit; }
  .ind-media { aspect-ratio: 3 / 2; background: var(--bone-deep); overflow: hidden; }
  .ind-media img { width: 100%; height: 100%; object-fit: cover; }
  .ind-body { padding: var(--s-5); display: flex; flex-direction: column; gap: var(--s-2); flex: 1; }
  .ind-body h3 { font-size: var(--fs-lg); }
  .ind-body p { font-size: var(--fs-sm); color: var(--text-muted); }
  .ind-go {
    margin-top: auto; padding-top: var(--s-4);
    font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ox);
  }

  /* ---------- shared ---------- */
  .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: start; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  .two-col h2 { margin-bottom: var(--s-5); font-size: var(--fs-2xl); }
  .step-h { font-family: var(--font-body); font-size: var(--fs-md); font-weight: 600; letter-spacing: 0; }
</style>
