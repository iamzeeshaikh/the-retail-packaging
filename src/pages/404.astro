---
import Base from '../layouts/Base.astro'
import { categories, productsIn } from '../lib/catalog'
const top = categories.map((c) => ({ ...c, n: productsIn(c.slug).length })).sort((a, b) => b.n - a.n).slice(0, 8)
---
<Base title="Page Not Found | The Retail Packaging" description="That page does not exist. Browse packaging categories or search the catalogue." path="/404/" noindex>
  <section class="section">
    <div class="wrap wrap-narrow">
      <p class="eyebrow">404</p>
      <h1>That page does not exist</h1>
      <p class="lede">The link may be out of date, or the address may have a typo. These are the most useful places to go next.</p>
      <div class="btn-row" style="margin-top:var(--s-8)">
        <a class="btn btn-primary btn-lg" href="/">Back to the homepage</a>
        <a class="btn btn-outline btn-lg" href="/search/">Search the catalogue</a>
      </div>
      <h2 style="margin-top:var(--s-16)">Packaging categories</h2>
      <ul class="nf-list" role="list">
        {top.map((c) => <li><a href={c.url}>{c.name} <span>{c.n}</span></a></li>)}
      </ul>
      <p class="muted" style="margin-top:var(--s-8)">
        The <a href="/sitemap/">full page index</a> lists every category, guide and article on the site.
      </p>
    </div>
  </section>
</Base>
<style>
  .nf-list { list-style:none; padding:0; margin:var(--s-5) 0 0; display:grid;
    grid-template-columns:repeat(auto-fill,minmax(min(220px,100%),1fr)); gap:var(--s-2); }
  .nf-list a { display:flex; justify-content:space-between; padding:var(--s-3) var(--s-4); background:var(--paper);
    border:1px solid var(--border); border-radius:var(--r-md); text-decoration:none; font-size:var(--fs-sm);
    color:var(--ink); min-height:44px; align-items:center; }
  .nf-list a:hover { border-color:var(--forest); color:var(--forest); }
  .nf-list span { color:var(--stone-300); font-size:var(--fs-xs); }
</style>
