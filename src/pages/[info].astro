---
import type { GetStaticPaths } from 'astro'
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Faqs from '../components/Faqs.astro'
import CtaBand from '../components/CtaBand.astro'
import QuoteForm from '../components/QuoteForm.astro'
import { infoPages, type InfoPage } from '../data/pages'
import { bySlug } from '../lib/catalog'
import { clampText } from '../lib/copy'
import * as S from '../lib/schema'

export const getStaticPaths = (() =>
  infoPages.map((p) => ({ params: { info: p.slug }, props: { page: p } }))) satisfies GetStaticPaths

const { page } = Astro.props as { page: InfoPage }
const path = `/${page.slug}/`
const hero = page.heroProduct ? bySlug.get(page.heroProduct) : undefined
const img = hero?.images?.[0]
const title = clampText(page.metaTitle, 62)
const description = clampText(page.description, 132)
const trail = [{ name: 'Home', url: '/' }, { name: page.title, url: path }]

const pageType =
  page.slug === 'about-us' ? 'AboutPage' : page.slug === 'contact-us' ? 'ContactPage' : 'WebPage'

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description, type: pageType as any, image: img ? `${img.base}-1400.webp` : undefined }),
  S.breadcrumbs(path, trail),
  S.faqPage(path, page.faqs),
])
---
<Base title={title} description={description} path={path}
  image={img ? `${img.base}-1400.webp` : undefined} schema={schema}>
  <Breadcrumbs trail={trail} />

  <section class="info-hero">
    <div class="wrap info-hero-in">
      <div>
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.h1}</h1>
        <p class="lede">{page.lede}</p>
        <div class="btn-row"><a class="btn btn-primary btn-lg" href="/request-a-quote/">Request a Quote</a></div>
      </div>
      {img && (
        <figure class="info-fig">
          <img src={`${img.base}-800.webp`}
            srcset={`${img.base}-400.webp 400w, ${img.base}-800.webp 800w, ${img.base}-1400.webp 1400w`}
            sizes="(max-width:900px) 94vw, 460px"
            width={img.width} height={img.height}
            alt={`${hero?.name} produced by The Retail Packaging`}
            fetchpriority="high" decoding="async" />
        </figure>
      )}
    </div>
  </section>

  <section class="section">
    <div class="wrap wrap-narrow prose">
      {page.sections.map((s) => (
        <>
          <h2>{s.h2}</h2>
          {s.body.map((b) => <p>{b}</p>)}
          {s.list && (
            <>
              {s.list.title && <h3>{s.list.title}</h3>}
              <ul>{s.list.items.map((i) => <li>{i}</li>)}</ul>
            </>
          )}
          {s.steps && (
            <div class="steps" style="margin-top:var(--s-6)">
              {s.steps.map((st) => (
                <div class="step">
                  <h3 style="font-size:var(--fs-md);margin-top:0">{st.h}</h3>
                  <p>{st.d}</p>
                </div>
              ))}
            </div>
          )}
          {s.table && (
            <div class="table-scroll" style="margin-top:var(--s-6)">
              <table class="data">
                {s.table.caption && <caption>{s.table.caption}</caption>}
                <thead><tr>{s.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>
                  {s.table.rows.map((r) => (
                    <tr>{r.map((c, i) => i === 0 ? <th scope="row">{c}</th> : <td>{c}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      ))}
    </div>
  </section>

  <section class="section section-sunken">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Get a price</p>
        <h2>Talk to us about your packaging</h2>
        <p class="lede">Send the product details and quantity. We reply with a specification and a written price, usually within one business day.</p>
      </div>
      <QuoteForm id="quote" source={`page:${page.slug}`} />
    </div>
  </section>

  <Faqs faqs={page.faqs} title={`${page.title} — Questions`} />
  <CtaBand />
</Base>

<style>
  .info-hero { background:linear-gradient(180deg,var(--bone),var(--bone-deep)); border-bottom:1px solid var(--border);
    padding-block:clamp(1.5rem,1rem + 2vw,3rem) clamp(2.5rem,2rem + 3vw,4rem); }
  .info-hero-in { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,0.8fr); gap:clamp(2rem,1rem + 4vw,4rem); align-items:center; }
  @media (max-width:900px){ .info-hero-in{ grid-template-columns:1fr; } }
  .info-hero .lede { margin-top:var(--s-5); }
  .info-hero .btn-row { margin-top:var(--s-8); }
  .info-fig { margin:0; border-radius:var(--r-lg); overflow:hidden; border:1px solid var(--border); aspect-ratio:4/3; }
  .info-fig img { width:100%; height:100%; object-fit:cover; }
  .two-col { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(2rem,1rem + 4vw,4rem); align-items:start; }
  @media (max-width:900px){ .two-col{ grid-template-columns:minmax(0,1fr); } }
  /* Without this the closing CTA heading sat flush against its lede on all
     twelve info pages — the global reset zeroes heading margins. */
  .two-col h2 { margin-bottom:var(--s-5); font-size:var(--fs-2xl); }
  .two-col p + p { margin-top:var(--s-4); }
  .prose > h2:first-child { margin-top:0; }
</style>
