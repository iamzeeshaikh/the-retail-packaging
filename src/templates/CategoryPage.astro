---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ProductCard from '../components/ProductCard.astro'
import CategoryCard from '../components/CategoryCard.astro'
import QuoteForm from '../components/QuoteForm.astro'
import QuickSpec from '../components/QuickSpec.astro'
import Faqs from '../components/Faqs.astro'
import CtaBand from '../components/CtaBand.astro'
import { productsIn, relatedCategories, categoryHero, type Category } from '../lib/catalog'
import { categoryFaqs, categoryIntro, categoryMeta, CATEGORY_NOTES } from '../lib/copy'
import { categoryContent } from '../data/categories'
import { industriesFor, FORM_FACTORS } from '../lib/taxonomy'
import { SITE } from '../lib/site'
import * as S from '../lib/schema'

export interface Props { category: Category }
const { category } = Astro.props

const list = productsIn(category.slug)
const path = category.url
const note = CATEGORY_NOTES[category.slug]
const inds = industriesFor(category.slug)
/* Written category content, where it exists: its own H1, section set and
   order, comparison table and FAQs. Falls back to the generated copy. */
const c = categoryContent(category.slug)
const intro = categoryIntro(category, list.length)
const faqs = c ? c.faqs : categoryFaqs(category, list.length)
const related = relatedCategories(category.slug, 4)
const gen = categoryMeta(category, list.length)
const title = c ? c.metaTitle : gen.title
const description = c ? c.metaDescription : gen.description
const short = category.name.replace(/^Custom /, '')

/* The catalogue grid, spec panel and gallery are fixed markup, so the declared
   section order is split around wherever the category places 'range'. */
const declared = c ? c.sections.filter((k) => k !== 'gallery') : []
const rangeAt = declared.indexOf('range')
const beforeRange = rangeAt >= 0 ? declared.slice(0, rangeAt) : declared
const afterRange = rangeAt >= 0 ? declared.slice(rangeAt + 1) : []

// Real capability set across the formats actually in this category.
const forms = [...new Set(list.map((p) => p.form.id))].map((id) => FORM_FACTORS[id])
const uniq = (xs: string[]) => [...new Set(xs)]
const materials = uniq(forms.flatMap((f) => f.materials)).slice(0, 8)
const printing = uniq(forms.flatMap((f) => f.printing))
const finishes = uniq(forms.flatMap((f) => f.finishes)).slice(0, 10)
const applications = uniq(forms.flatMap((f) => f.applications)).slice(0, 6)

const hero = categoryHero(category.slug)
const heroImg = hero?.images?.[0]

// Products with the deepest galleries make the best showcase tiles.
const gallery = [...list].sort((a, b) => b.images.length - a.images.length).slice(0, 6)
const showcase = gallery.slice(0, 3)

const schema = S.graph([
  S.organization(), S.website(),
  S.webPage({ path, title, description, type: 'CollectionPage', image: heroImg ? `${heroImg.base}-1400.webp` : undefined }),
  S.breadcrumbs(path, [{ name: 'Home', url: '/' }, { name: category.name, url: path }]),
  S.itemList(path, list.map((p) => ({ name: p.name, url: p.url }))),
  S.faqPage(path, faqs),
])
---

<Base
  title={title} description={description} path={path}
  image={heroImg ? `${heroImg.base}-1400.webp` : undefined}
  imageAlt={`${category.name} produced by The Retail Packaging`}
  schema={schema}
  preloadImage={heroImg ? {
    href: `${heroImg.base}-1400.webp`,
    srcset: `${heroImg.base}-800.webp 800w, ${heroImg.base}-1400.webp 1400w`,
    sizes: '(max-width: 900px) 96vw, 52vw',
  } : undefined}
>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: category.name, url: path }]} />

  <!-- ============ HERO ============ -->
  <section class="c-hero">
    <div class="wrap c-hero-in">
      <div class="c-copy">
        <p class="eyebrow">{c ? c.eyebrow : `${list.length} made-to-order formats`}</p>
        <h1>{c ? c.h1 : category.name}</h1>
        {c ? <p class="c-p c-lede">{c.lede}</p> : intro.map((para) => <p class="c-p">{para}</p>)}
        <dl class="c-facts">
          <div><dt>Minimum</dt><dd>100 units</dd></div>
          <div><dt>Production</dt><dd>3–5 days</dd></div>
          <div><dt>Delivery</dt><dd>All 50 states</dd></div>
        </dl>
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="#quote">Request a Quote</a>
          <a class="btn btn-outline btn-lg" href="#range">See the range</a>
        </div>
      </div>
      {heroImg && (
        <figure class="c-fig">
          <img src={`${heroImg.base}-1400.webp`}
            srcset={`${heroImg.base}-800.webp 800w, ${heroImg.base}-1400.webp 1400w`}
            sizes="(max-width: 900px) 96vw, 52vw"
            width={heroImg.width} height={heroImg.height}
            alt={`${hero?.name} from the ${short.toLowerCase()} range, printed to a custom specification`}
            fetchpriority="high" decoding="async" />
        </figure>
      )}
    </div>
  </section>

  <!-- ============ SHOWCASE STRIP ============ -->
  {showcase.length === 3 && (
    <section class="section-tight showcase">
      <div class="wrap show-grid">
        {showcase.map((p, i) => (
          <a class="show" href={p.url}>
            {p.images[i + 1] ? (
              <img src={`${p.images[i + 1].base}-800.webp`}
                srcset={`${p.images[i + 1].base}-400.webp 400w, ${p.images[i + 1].base}-800.webp 800w`}
                sizes="(max-width: 780px) 92vw, 33vw"
                width={p.images[i + 1].width} height={p.images[i + 1].height}
                loading="lazy" decoding="async"
                alt={`${p.name} photographed to show finish and proportion`} />
            ) : (
              <img src={`${p.images[0].base}-800.webp`} width={p.images[0].width} height={p.images[0].height}
                loading="lazy" decoding="async" alt={`${p.name} custom printed`} />
            )}
            <span class="show-cap">{p.name}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ============ composed sections: order set by the category ============ -->
  {c && beforeRange.map((key, i) => {
    const sunken = i % 2 === 1
    const cls = `section ${sunken ? 'section-sunken' : ''}`

    if (key === 'intro' || key === 'guidance' || key === 'materials') {
      const b = key === 'intro' ? c.intro : key === 'guidance' ? c.guidance : c.materials
      if (!b) return null
      return (
        <section class={cls}>
          <div class="wrap"><div class="cc-prose">
            <h2>{b.h}</h2>
            {b.body.map((t) => <p>{t}</p>)}
          </div></div>
        </section>
      )
    }

    if (key === 'subgroups' && c.subgroups) {
      return (
        <section class={cls}>
          <div class="wrap">
            <div class="cc-head"><h2>{c.subgroups.h}</h2><p class="lede">{c.subgroups.intro}</p></div>
            <div class="cc-groups">
              {c.subgroups.items.map((g) => (
                <article class="cc-group">
                  <h3>{g.name}</h3>
                  <p>{g.detail}</p>
                  <ul class="cc-links" role="list">
                    {g.slugs.map((sl) => {
                      const prod = list.find((x) => x.slug === sl)
                      return prod ? <li><a href={prod.url}>{prod.name}</a></li> : null
                    })}
                  </ul>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    if (key === 'chooseTable' && c.chooseTable) {
      const t = c.chooseTable
      return (
        <section class={cls}>
          <div class="wrap">
            <div class="cc-head"><h2>{t.h}</h2><p class="lede">{t.intro}</p></div>
            <div class="table-scroll">
              <table class="data">
                <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>{t.rows.map((r) => (
                  <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>
                ))}</tbody>
              </table>
            </div>
          </div>
        </section>
      )
    }

    if (key === 'applications' && c.applications) {
      return (
        <section class={cls}>
          <div class="wrap"><div class="cc-prose">
            <h2>{c.applications.h}</h2>
            <p>{c.applications.intro}</p>
            <ul class="cc-bullets">{c.applications.items.map((x) => <li>{x}</li>)}</ul>
          </div></div>
        </section>
      )
    }

    if (key === 'mistakes' && c.mistakes) {
      return (
        <section class={cls}>
          <div class="wrap cc-split">
            <div><h2>{c.mistakes.h}</h2><p class="lede">{c.mistakes.intro}</p></div>
            <ol class="cc-check" role="list">{c.mistakes.items.map((x) => <li>{x}</li>)}</ol>
          </div>
        </section>
      )
    }

    if (key === 'resources') {
      return (
        <section class={cls}>
          <div class="wrap">
            <h2 class="cc-h2">Worth reading before you specify</h2>
            <ul class="cc-res" role="list">
              {c.resources.map((r) => (
                <li><a href={r.href}>{r.anchor}</a><span>{r.note}</span></li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    return null
  })}

  <!-- ============ RANGE ============ -->
  <section class="section" id="range">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">The range</p>
          <h2>{category.name} We Produce</h2>
        </div>
        {list.length > 8 && (
          <div class="filter-bar">
            <label class="sr-only" for="cat-filter">Filter this category</label>
            <input class="input" id="cat-filter" type="search" placeholder={`Filter ${list.length} formats`} data-filter autocomplete="off" />
            <p class="filter-count" data-filter-count aria-live="polite"></p>
          </div>
        )}
      </div>
      <div class="grid g-4" data-filter-grid>
        {list.map((p, i) => (
          <div data-name={p.name.toLowerCase()}>
            <ProductCard product={p} loading={i < 4 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <p class="empty" data-filter-empty hidden>No format matches that. Try a shorter word, or <a href="/request-a-quote/">describe what you need in a quote request</a>.</p>
    </div>
  </section>

  <!-- ============ SPEC SECTION ============ -->
  <section class="section section-sunken">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Specification</p>
          <h2>Choosing a {short} Specification</h2>
        </div>
      </div>
      <div class="spec-cols">
        <div class="tile">
          <h3>Materials</h3>
          <ul class="dot-list">{materials.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            {note?.decides ?? 'Board weight follows product weight.'}
            {' '}Our <a href="/resources/packaging-material-guide/">guide to packaging board and film grades</a>
            {' '}compares them on strength, print quality and cost.
          </p>
        </div>
        <div class="tile">
          <h3>Printing</h3>
          <ul class="dot-list">{printing.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Run length usually decides this. Digital wins on shorter quantities because there is no
            plate cost; beyond that, offset and flexo overtake it on price per unit.
          </p>
        </div>
        <div class="tile">
          <h3>Finishes</h3>
          <ul class="dot-list">{finishes.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Finishes are applied in the same production run. Each one adds a step, so we price them
            individually rather than bundling them into the base rate.
          </p>
        </div>
        <div class="tile">
          <h3>Applications</h3>
          <ul class="dot-list">{applications.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Most orders here come from {inds.map((i) => i.name.toLowerCase()).join(', ')} brands.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPECIFICATION BUILDER ============ -->
  <QuickSpec
    categorySlug={category.slug}
    variant="band"
    title={`Specify your ${short.toLowerCase()} in under a minute`}
  />

  <!-- ============ GALLERY ============ -->
  {gallery.length >= 4 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Recent work</p>
            <h2>{short} We Have Produced</h2>
          </div>
        </div>
        <div class="mosaic">
          {gallery.slice(0, 6).map((p, i) => {
            const im = p.images[Math.min(i, p.images.length - 1)]
            return (
              <a class={`mo mo-${i}`} href={p.url}>
                <img src={`${im.base}-800.webp`}
                  srcset={`${im.base}-400.webp 400w, ${im.base}-800.webp 800w`}
                  sizes="(max-width: 780px) 92vw, 33vw"
                  width={im.width} height={im.height} loading="lazy" decoding="async"
                  alt={`${p.name} produced as custom ${short.toLowerCase()}`} />
                <span class="mo-cap">{p.name}</span>
              </a>
            )
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ============ remaining declared sections ============ -->
  {c && afterRange.map((key, i) => {
    const sunken = i % 2 === 0
    const cls = `section ${sunken ? 'section-sunken' : ''}`
    if (key === 'intro' || key === 'guidance' || key === 'materials') {
      const b = key === 'intro' ? c.intro : key === 'guidance' ? c.guidance : c.materials
      if (!b) return null
      return (
        <section class={cls}><div class="wrap"><div class="cc-prose">
          <h2>{b.h}</h2>{b.body.map((t) => <p>{t}</p>)}
        </div></div></section>
      )
    }
    if (key === 'chooseTable' && c.chooseTable) {
      const t = c.chooseTable
      return (
        <section class={cls}><div class="wrap">
          <div class="cc-head"><h2>{t.h}</h2><p class="lede">{t.intro}</p></div>
          <div class="table-scroll"><table class="data">
            <thead><tr>{t.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
            <tbody>{t.rows.map((r) => (<tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>))}</tbody>
          </table></div>
        </div></section>
      )
    }
    if (key === 'applications' && c.applications) {
      return (
        <section class={cls}><div class="wrap"><div class="cc-prose">
          <h2>{c.applications.h}</h2><p>{c.applications.intro}</p>
          <ul class="cc-bullets">{c.applications.items.map((x) => <li>{x}</li>)}</ul>
        </div></div></section>
      )
    }
    if (key === 'mistakes' && c.mistakes) {
      return (
        <section class={cls}><div class="wrap cc-split">
          <div><h2>{c.mistakes.h}</h2><p class="lede">{c.mistakes.intro}</p></div>
          <ol class="cc-check" role="list">{c.mistakes.items.map((x) => <li>{x}</li>)}</ol>
        </div></section>
      )
    }
    if (key === 'resources') {
      return (
        <section class={cls}><div class="wrap">
          <h2 class="cc-h2">Worth reading before you specify</h2>
          <ul class="cc-res" role="list">
            {c.resources.map((r) => (<li><a href={r.href}>{r.anchor}</a><span>{r.note}</span></li>))}
          </ul>
        </div></section>
      )
    }
    return null
  })}

  <!-- ============ QUOTE ============ -->
  <section class="section" id="quote">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Get a price</p>
        <h2>Quote a {short} Run</h2>
        <p class="lede">
          Send the product details and the quantity you have in mind. We reply with a specification
          and a written price, usually within one business day.
        </p>
        <p class="muted small" style="margin-top:var(--s-5)">{SITE.priceLine}</p>
      </div>
      <QuoteForm id="quote-form" source={`category:${category.slug}`} categoryName={category.name} title={`Quote ${category.name}`} />
    </div>
  </section>

  <Faqs faqs={faqs} title={`${category.name} Questions`} />

  {related.length > 0 && (
    <section class="section section-sunken">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Related ranges</p>
            <h2>Other Categories Worth Comparing</h2>
          </div>
        </div>
        <div class="grid g-4">
          {related.map((r) => (
            <CategoryCard category={r} count={productsIn(r.slug).length} sample={categoryHero(r.slug)} />
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title={`Ready to Specify Your ${short}?`} />
</Base>

<style>
  /* ---------- hero ---------- */
  .c-hero { padding-block: var(--s-4) clamp(2.5rem, 2rem + 3vw, 4.5rem); }
  .c-hero-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: center; }
  @media (max-width: 900px) { .c-hero-in { grid-template-columns: 1fr; } }
  .c-hero h1 { font-size: clamp(2.2rem, 1.4rem + 3.4vw, 4rem); max-width: 16ch; }
  .c-p { color: var(--text-muted); font-size: var(--fs-md); max-width: 58ch; margin-top: var(--s-4); }
  .c-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); margin-top: var(--s-8); }
  .c-facts div { border-top: 1px solid var(--ink); padding-top: var(--s-3); }
  .c-facts dt { font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-faint); }
  .c-facts dd { margin: 0.2rem 0 0; font-size: var(--fs-sm); font-weight: 500; color: var(--ink); }
  .c-hero .btn-row { margin-top: var(--s-8); }
  .c-fig { margin: 0; overflow: hidden; border-radius: var(--r-lg); background: var(--bone-deep); aspect-ratio: 5/4; }
  .c-fig img { width: 100%; height: 100%; object-fit: cover; }

  /* ---------- showcase strip ---------- */
  .showcase { background: var(--bone-deep); }
  .show-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  @media (max-width: 780px) { .show-grid { grid-template-columns: 1fr; } }
  .show { position: relative; display: block; overflow: hidden; border-radius: var(--r-md);
    aspect-ratio: 3/2; text-decoration: none; }
  .show img { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out); }
  .show:hover img { transform: scale(1.05); }
  .show::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,10,.68), transparent 55%); }
  .show-cap { position: absolute; left: var(--s-4); bottom: var(--s-3); z-index: 1; color: #fff;
    font-size: var(--fs-sm); font-weight: 500; }

  /* ---------- mosaic ---------- */
  .mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: minmax(150px, auto); gap: var(--s-3); }
  @media (max-width: 900px) { .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .mo { position: relative; display: block; overflow: hidden; border-radius: var(--r-md); text-decoration: none; }
  .mo img { width: 100%; height: 100%; object-fit: cover; transition: transform 800ms var(--ease-out); }
  .mo:hover img { transform: scale(1.05); }
  .mo::after { content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,10,.6), transparent 52%); }
  .mo-cap { position: absolute; left: var(--s-4); bottom: var(--s-3); z-index: 1; color: #fff;
    font-size: var(--fs-xs); font-weight: 500; letter-spacing: 0.02em; }
  .mo-0 { grid-column: span 2; grid-row: span 2; }
  .mo-3 { grid-column: span 2; }
  @media (max-width: 900px) { .mo-0, .mo-3 { grid-column: span 2; grid-row: auto; } }

  /* ---------- shared ---------- */
  .sec-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between;
    gap: var(--s-5); margin-bottom: var(--s-8); border-top: 1px solid var(--ink); padding-top: var(--s-5); }
  .sec-head h2 { font-size: var(--fs-2xl); }
  .filter-bar { min-width: min(280px, 100%); }
  .filter-count { font-size: var(--fs-xs); color: var(--text-faint); margin-top: var(--s-2); }
  .empty { margin-top: var(--s-8); color: var(--text-muted); }

  .spec-cols { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
  @media (max-width: 1100px) { .spec-cols { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .spec-cols { grid-template-columns: 1fr; } }
  .spec-cols h3 { font-size: var(--fs-lg); margin-bottom: var(--s-4); }
  .dot-list { list-style: none; padding: 0; margin: 0 0 var(--s-4); display: grid; gap: 0.4rem; }
  .dot-list li { position: relative; padding-left: 1.1rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .dot-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px;
    border-radius: 50%; background: var(--accent); }
  .tile-note { font-size: var(--fs-sm); color: var(--text-muted); border-top: 1px solid var(--rule); padding-top: var(--s-4); }

  /* ---------- composed category sections ---------- */
  .cc-prose { max-width: 74ch; margin-inline: auto; }
  .cc-prose h2, .cc-head h2, .cc-h2, .cc-split h2 {
    font-size: var(--fs-2xl); margin-bottom: var(--s-5); text-wrap: balance;
    overflow-wrap: break-word; word-break: normal;
  }
  .cc-prose p { color: var(--text-muted); font-size: var(--fs-md); line-height: 1.65; }
  .cc-prose p + p { margin-top: var(--s-4); }
  .cc-head { max-width: 68ch; margin-bottom: var(--s-8); }
  .cc-bullets { margin-top: var(--s-5); padding-left: 1.1rem; display: grid; gap: var(--s-2); }
  .cc-bullets li { color: var(--text-muted); font-size: var(--fs-md); }

  .cc-groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: var(--s-5); }
  .cc-group { background: var(--paper); border: 1px solid var(--border); border-radius: var(--r-md); padding: var(--s-6); }
  .cc-group h3 { font-size: var(--fs-md); margin-bottom: var(--s-3); }
  .cc-group p { color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.6; }
  .cc-links { list-style: none; padding: 0; margin-top: var(--s-4); display: grid; gap: var(--s-2); }
  .cc-links a { font-size: var(--fs-sm); }

  .cc-split { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: start; }
  @media (max-width: 900px) { .cc-split { grid-template-columns: minmax(0, 1fr); } }
  .cc-check { list-style: none; padding: 0; counter-reset: cc; display: grid; gap: var(--s-3); }
  .cc-check li {
    counter-increment: cc; position: relative; padding: var(--s-4) var(--s-5) var(--s-4) 3.25rem;
    background: var(--paper); border: 1px solid var(--border); border-radius: var(--r-sm);
    color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.6;
  }
  .cc-check li::before {
    content: counter(cc, decimal-leading-zero); position: absolute; left: var(--s-5); top: var(--s-4);
    color: var(--accent); font-size: var(--fs-xs); font-weight: 600; font-variant-numeric: tabular-nums;
  }

  .cc-res { list-style: none; padding: 0; margin-top: var(--s-6);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: var(--s-4); }
  .cc-res li { border-top: 1px solid var(--rule); padding-top: var(--s-4); display: flex; flex-direction: column; gap: var(--s-2); }
  .cc-res span { color: var(--text-muted); font-size: var(--fs-sm); line-height: 1.55; }

  .c-lede { font-size: var(--fs-md); }

  .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: start; }
  @media (max-width: 900px) { .two-col { grid-template-columns: minmax(0, 1fr); } }
  .two-col h2 { margin-bottom: var(--s-4); font-size: var(--fs-2xl); }
  .two-col p + p { margin-top: var(--s-4); }
  .step-h { font-family: var(--font-body); font-size: var(--fs-md); font-weight: 600; letter-spacing: 0; }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]')
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]')
  const count = document.querySelector<HTMLElement>('[data-filter-count]')
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]')

  if (input && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-name]'))
    const total = cards.length
    let t: number | undefined
    const apply = () => {
      const q = input.value.trim().toLowerCase()
      let shown = 0
      cards.forEach((c) => {
        const hit = !q || (c.dataset.name ?? '').includes(q)
        c.hidden = !hit
        if (hit) shown++
      })
      if (count) count.textContent = q ? `${shown} of ${total} shown` : ''
      if (empty) empty.hidden = shown !== 0
    }
    input.addEventListener('input', () => { window.clearTimeout(t); t = window.setTimeout(apply, 120) })
  }
</script>
