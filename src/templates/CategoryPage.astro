---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import ProductCard from '../components/ProductCard.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Faqs from '../components/Faqs.astro'
import CtaBand from '../components/CtaBand.astro'
import { productsIn, relatedCategories, pickN } from '../lib/catalog'
import { categoryFaqs, categoryIntro, categoryMeta, CATEGORY_NOTES } from '../lib/copy'
import { industriesFor, FORM_FACTORS } from '../lib/taxonomy'
import { SITE } from '../lib/site'
import * as S from '../lib/schema'

import type { Category } from '../lib/catalog'

export interface Props { category: Category }
const { category } = Astro.props
const list = productsIn(category.slug)
const path = category.url
const note = CATEGORY_NOTES[category.slug]
const inds = industriesFor(category.slug)
const intro = categoryIntro(category, list.length)
const faqs = categoryFaqs(category, list.length)
const related = relatedCategories(category.slug, 4)
const { title, description } = categoryMeta(category, list.length)

// Aggregate the real capability set across the formats in this category.
const forms = [...new Set(list.map((p) => p.form.id))].map((id) => FORM_FACTORS[id])
const uniq = (xs: string[]) => [...new Set(xs)]
const materials = uniq(forms.flatMap((f) => f.materials)).slice(0, 8)
const printing = uniq(forms.flatMap((f) => f.printing))
const finishes = uniq(forms.flatMap((f) => f.finishes)).slice(0, 10)
const applications = uniq(forms.flatMap((f) => f.applications)).slice(0, 6)

const hero = list[0]?.images?.[0]
// Products worth surfacing in body copy — the ones with the deepest galleries.
const highlights = [...list].sort((a, b) => b.images.length - a.images.length).slice(0, 3)

const schema = S.graph([
  S.organization(),
  S.website(),
  S.webPage({ path, title, description, type: 'CollectionPage', image: hero ? `${hero.base}-1400.webp` : undefined }),
  S.breadcrumbs(path, [{ name: 'Home', url: '/' }, { name: category.name, url: path }]),
  S.itemList(path, list.map((p) => ({ name: p.name, url: p.url }))),
  S.faqPage(path, faqs),
])
---

<Base
  title={title}
  description={description}
  path={path}
  image={hero ? `${hero.base}-1400.webp` : undefined}
  imageAlt={`${category.name} produced by The Retail Packaging`}
  schema={schema}
  preloadImage={hero ? {
    href: `${hero.base}-800.webp`,
    srcset: `${hero.base}-400.webp 400w, ${hero.base}-800.webp 800w, ${hero.base}-1400.webp 1400w`,
    sizes: '(max-width: 900px) 94vw, 520px',
  } : undefined}
>
  <Breadcrumbs trail={[{ name: 'Home', url: '/' }, { name: category.name, url: path }]} />

  <!-- hero -->
  <section class="cat-hero">
    <div class="wrap cat-hero-in">
      <div>
        <p class="eyebrow">{list.length} made-to-order {list.length === 1 ? 'format' : 'formats'}</p>
        <h1>{category.name}</h1>
        {intro.map((para) => <p class="cat-p">{para}</p>)}
        <div class="btn-row">
          <a class="btn btn-primary btn-lg" href="#quote">Request a Quote</a>
          <a class="btn btn-outline btn-lg" href="#range">See the {list.length} formats</a>
        </div>
      </div>
      {hero && (
        <figure class="cat-figure">
          <img
            src={`${hero.base}-800.webp`}
            srcset={`${hero.base}-400.webp 400w, ${hero.base}-800.webp 800w, ${hero.base}-1400.webp 1400w`}
            sizes="(max-width: 900px) 94vw, 520px"
            width={hero.width} height={hero.height}
            alt={`${list[0].name} from the ${category.name.toLowerCase()} range, printed to a custom specification`}
            fetchpriority="high" decoding="async"
          />
        </figure>
      )}
    </div>
  </section>

  <!-- product listing -->
  <section class="section" id="range">
    <div class="wrap">
      <div class="listing-head">
        <div>
          <p class="eyebrow">The range</p>
          <h2>{category.name} We Produce</h2>
        </div>
        {list.length > 8 && (
          <div class="filter-bar">
            <label class="sr-only" for="cat-filter">Filter this category</label>
            <input class="input" id="cat-filter" type="search" placeholder={`Filter ${list.length} formats`} data-filter autocomplete="off" />
            <p class="filter-count" data-filter-count aria-live="polite"></p>
          </div>
        )}
      </div>

      <div class="grid g-4" data-filter-grid>
        {list.map((p, i) => (
          <div class="reveal" data-name={p.name.toLowerCase()}>
            <ProductCard product={p} loading={i < 4 ? 'eager' : 'lazy'} />
          </div>
        ))}
      </div>
      <p class="empty" data-filter-empty hidden>No format matches that. Try a shorter word, or <a href="/request-a-quote/">describe what you need in a quote request</a>.</p>
    </div>
  </section>

  <!-- specification detail -->
  <section class="section section-sunken">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Specification</p>
        <h2>Choosing a {category.name.replace(/^Custom /, '')} Specification</h2>
      </div>
      <div class="spec-cols">
        <div class="tile">
          <h3>Materials available</h3>
          <ul class="dot-list">{materials.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            {note?.decides ?? 'Board weight follows product weight.'}
            {' '}Our <a href="/resources/packaging-material-guide/">guide to packaging board and film grades</a>
            {' '}compares them on strength, print quality and cost.
          </p>
        </div>
        <div class="tile">
          <h3>Printing Options</h3>
          <ul class="dot-list">{printing.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Run length usually decides this. Digital wins under about 1,000 units because there is no
            plate cost; beyond that, offset and flexo overtake it on price per unit.
          </p>
        </div>
        <div class="tile">
          <h3>Finishes and add-ons</h3>
          <ul class="dot-list">{finishes.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Finishes are applied in the same production run. Each one adds a step, so we price them
            individually rather than bundling them into the base rate.
          </p>
        </div>
        <div class="tile">
          <h3>Common applications</h3>
          <ul class="dot-list">{applications.map((m) => <li>{m}</li>)}</ul>
          <p class="tile-note">
            Most orders here come from {inds.map((i) => i.name.toLowerCase()).join(', ')} brands.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- benefits + process -->
  <section class="section">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Why this range</p>
        <h2>What You Get with {category.name}</h2>
        <p class="lede">{note?.angle}</p>
        <p class="muted">
          Nothing in this range is a stock item. We cut a dieline for your product, choose a board
          that suits its weight, and print in whatever way makes sense for your quantity.
          {highlights[0] && (
            <>
              {' '}Buyers comparing options in this category often start with
              {' '}<a href={highlights[0].url}>{highlights[0].name.toLowerCase()} and their material choices</a>
              {' '}before narrowing the specification.
            </>
          )}
        </p>
        <ul class="tick-list">
          <li>Dimensions cut to your product, not to a stock size</li>
          <li>Board grade recommended against real product weight</li>
          <li>Printing and finishing completed in one run</li>
          <li>Written specification before you commit to production</li>
        </ul>
      </div>
      <div class="steps">
        {[
          { h: 'Share the product', d: `Dimensions, weight and how it ships. ${note?.watchOut ?? ''}` },
          { h: 'We specify and quote', d: 'Board grade, structure, print route, lead time and a written price.' },
          { h: 'Dieline and proof', d: 'A template sized to your product, then a digital proof or a physical sample.' },
          { h: 'Production and delivery', d: 'Typically 3 to 5 business days after approval, shipped anywhere in the US.' },
        ].map((x) => (
          <div class="step reveal">
            <h3 style="font-size:var(--fs-md)">{x.h}</h3>
            <p class="muted" style="font-size:var(--fs-sm);margin-top:var(--s-1)">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- quote -->
  <section class="section section-sunken">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Get a price</p>
        <h2>Quote a {category.name.replace(/^Custom /, '')} Run</h2>
        <p class="lede">
          Send the product details and the quantity you have in mind. We reply with a specification
          and a written price, usually within one business day.
        </p>
        <p class="muted">{SITE.priceLine}</p>
      </div>
      <QuoteForm id="quote" source={`category:${category.slug}`} categoryName={category.name} title={`Quote ${category.name}`} />
    </div>
  </section>

  <Faqs faqs={faqs} title={`${category.name} Questions`} intro={`What buyers ask before ordering ${category.name.toLowerCase()}.`} />

  <!-- related categories -->
  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Related ranges</p>
          <h2>Other Categories Worth Comparing</h2>
        </div>
        <div class="grid g-4">
          {related.map((r) => (
            <a class="rel-card tile reveal" href={r.url}>
              <h3>{r.name}</h3>
              <p>{productsIn(r.slug).length} formats</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title={`Ready to Specify Your ${category.name.replace(/^Custom /, '')}?`} />
</Base>

<style>
  .cat-hero {
    background: linear-gradient(180deg, var(--bone), var(--bone-deep));
    border-bottom: 1px solid var(--border);
    padding-block: clamp(1.5rem, 1rem + 2.5vw, 3.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }
  .cat-hero-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: center; }
  @media (max-width: 900px) { .cat-hero-in { grid-template-columns: 1fr; } }
  .cat-hero h1 { max-width: 18ch; }
  .cat-p { color: var(--text-muted); font-size: var(--fs-md); max-width: 60ch; margin-top: var(--s-4); }
  .cat-hero .btn-row { margin-top: var(--s-8); }
  .cat-figure { margin: 0; border-radius: var(--r-lg); overflow: hidden; border: 1px solid var(--border); background: var(--bone-deep); aspect-ratio: 4/3; }
  .cat-figure img { width: 100%; height: 100%; object-fit: cover; }

  .listing-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: var(--s-6); margin-bottom: var(--s-8); }
  .filter-bar { min-width: min(280px, 100%); }
  .filter-count { font-size: var(--fs-xs); color: var(--text-faint); margin-top: var(--s-2); }
  .empty { margin-top: var(--s-8); color: var(--text-muted); }

  .spec-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
  @media (max-width: 820px) { .spec-cols { grid-template-columns: 1fr; } }
  .spec-cols h3 { font-size: var(--fs-lg); margin-bottom: var(--s-4); }
  .dot-list { list-style: none; padding: 0; margin: 0 0 var(--s-4); display: grid; gap: 0.4rem; }
  .dot-list li { position: relative; padding-left: 1.1rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .dot-list li::before { content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  .tile-note { font-size: var(--fs-sm); color: var(--text-muted); border-top: 1px solid var(--border); padding-top: var(--s-4); }

  .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: start; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } }
  .two-col h2 { margin-bottom: var(--s-4); }

  .tick-list { list-style: none; padding: 0; margin: var(--s-5) 0 0; display: grid; gap: var(--s-2); }
  .tick-list li { position: relative; padding-left: 1.75rem; font-size: var(--fs-sm); color: var(--text-muted); }
  .tick-list li::before { content: ''; position: absolute; left: 0; top: 0.45em; width: .95rem; height: .5rem;
    border-left: 2px solid var(--accent); border-bottom: 2px solid var(--accent); transform: rotate(-45deg); }

  .rel-card { text-decoration: none; display: block; transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease); }
  .rel-card:hover { border-color: var(--rule-strong); transform: translateY(-3px); }
  .rel-card h3 { font-size: var(--fs-md); color: var(--ink); }
  .rel-card p { font-size: var(--fs-sm); color: var(--text-faint); margin-top: var(--s-1); }
</style>

<script>
  // Client-side filter. No URL parameters are written, so no indexable
  // duplicate filter pages are ever created.
  const input = document.querySelector<HTMLInputElement>('[data-filter]')
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]')
  const count = document.querySelector<HTMLElement>('[data-filter-count]')
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]')

  if (input && grid) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-name]'))
    const total = cards.length
    let t: number | undefined

    const apply = () => {
      const q = input.value.trim().toLowerCase()
      let shown = 0
      cards.forEach((c) => {
        const hit = !q || (c.dataset.name ?? '').includes(q)
        c.hidden = !hit
        if (hit) shown++
      })
      if (count) count.textContent = q ? `${shown} of ${total} shown` : ''
      if (empty) empty.hidden = shown !== 0
    }

    input.addEventListener('input', () => {
      window.clearTimeout(t)
      t = window.setTimeout(apply, 120)
    })
  }
</script>
