---
import Base from '../layouts/Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import Gallery from '../components/Gallery.astro'
import QuickSpec from '../components/QuickSpec.astro'
import ProductCard from '../components/ProductCard.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Faqs from '../components/Faqs.astro'
import CtaBand from '../components/CtaBand.astro'
import { relatedProducts, categoryBySlug, type Product } from '../lib/catalog'
import { productMeta, productSummary, productBenefits, PRICE_LINE, CATEGORY_NOTES } from '../lib/copy'
import { traitsOf, layoutFor, sectionsFor } from '../lib/product-traits'
import { buildSection } from '../lib/product-sections'
import { productFaqsFor } from '../lib/product-faqs'
import {
  quoteHeading, quoteIntro, benefitsHeading, benefitsEyebrow,
  relatedHeading, faqHeading, ctaHeading, ctaText,
} from '../lib/product-headings'
import { specLine, minQty, leadTime, fmtQty } from '../lib/commerce'
import { SITE } from '../lib/site'
import * as S from '../lib/schema'

export interface Props { product: Product }
const { product: p } = Astro.props

const f = p.form
const path = p.url
const cat = categoryBySlug.get(p.categorySlug)!
const note = CATEGORY_NOTES[p.categorySlug]
/* Composition: traits from the product decide the layout, which sections the
   page carries, the order they run in and what each one says. */
const traits = traitsOf(p)
const layout = layoutFor(p, traits)
const sectionKeys = sectionsFor(p, traits, layout)
const blocks = sectionKeys
  .map((k) => ({ key: k, block: buildSection(k, p, traits) }))
  .filter((x) => x.block) as { key: string; block: NonNullable<ReturnType<typeof buildSection>> }[]
const faqs = productFaqsFor(p, traits)
const benefits = productBenefits(p)
const related = relatedProducts(p, 4)
/* Headings for the fixed bands. Derived from the same traits that chose the
   layout, so the labels match what the page actually argues. */
const hc = { p, t: traits, layout }
const { title, description } = productMeta(p)
const hero = p.images[0]

const trail = [
  { name: 'Home', url: '/' },
  { name: cat.name, url: cat.url },
  { name: p.name, url: path },
]

/* A Map, not an array: most forms also define Construction in specNotes, which
   printed the row twice — "Paper bag" and then "Side-gusseted, bottom-glued".
   The later, more specific value wins and keeps the row in its original place. */
const specs: [string, string][] = [
  ...new Map<string, string>([
    ['Product', p.name],
    ['Category', cat.name],
    ['Construction', f.singular.charAt(0).toUpperCase() + f.singular.slice(1)],
    ...Object.entries(f.specNotes),
    ['Materials', f.materials.slice(0, 4).join(', ')],
    ['Printing', f.printing.join(', ')],
    ['Finishes', f.finishes.slice(0, 5).join(', ')],
    ['Minimum order', f.moq.replace(/^[^.]*?from /i, 'From ').split('.')[0] + '.'],
    ['Lead time', '3 to 5 business days after artwork approval'],
    ['Shipping', 'Across the US, UK, Canada and Australia'],
  ]),
]

const schema = S.graph([
  S.organization(),
  S.website(),
  S.webPage({ path, title, description, type: 'ItemPage', image: hero ? `${hero.base}-1400.webp` : undefined }),
  S.breadcrumbs(path, trail),
  S.product({
    path,
    name: p.name,
    description: `${productSummary(p)} ${f.sizing}`,
    images: p.images.slice(0, 6).map((i) => `${i.base}-1400.webp`),
    category: cat.name,
    material: f.materials[0],
    // No rating passed — verified review data does not exist yet.
  }),
  S.faqPage(path, faqs),
])
---

<Base
  title={title}
  description={description}
  path={path}
  image={hero ? `${hero.base}-1400.webp` : undefined}
  imageAlt={`${p.name} manufactured by The Retail Packaging`}
  schema={schema}
  preloadImage={hero ? {
    href: `${hero.base}-800.webp`,
    srcset: `${hero.base}-400.webp 400w, ${hero.base}-800.webp 800w, ${hero.base}-1400.webp 1400w`,
    sizes: '(max-width: 900px) 94vw, 620px',
  } : undefined}
>
  <Breadcrumbs trail={trail} />

  <!-- ============ top: gallery + short quote form ============ -->
  <section class="p-top">
    <div class="wrap p-grid">
      <div class="p-media">
        <p class="p-eyebrow">{cat.name}</p>
        <h1>{p.name}</h1>
        <p class="p-summary">{productSummary(p)}</p>

        <dl class="p-facts">
          <div><dt>Minimum order</dt><dd>{fmtQty(minQty(p))} units</dd></div>
          <div><dt>Production</dt><dd>{leadTime(p)[0]}–{leadTime(p)[1]} business days</dd></div>
          <div><dt>Construction</dt><dd>{f.singular}</dd></div>
          <div><dt>Delivery</dt><dd>US, UK, Canada, Australia</dd></div>
        </dl>

        <Gallery product={p} />
      </div>

      <div class="p-panel">
        <QuoteForm
          id="quote"
          variant="short"
          productName={p.name}
          categoryName={cat.name}
          source={`product:${p.slug}`}
          title={quoteHeading(hc)}
          intro={quoteIntro(hc)}
        />
      </div>
    </div>
  </section>

  <!-- ============ composed sections: order and content vary by product ============ -->
  {blocks.map(({ key, block }, i) => (
    <section class={`section ${i % 2 === 1 ? 'section-sunken' : ''} pb-${key}`}>
      <div class="wrap">
        <div class={block.table ? 'pb-wide' : 'pb-prose'}>
          <h2>{block.h}</h2>
          {block.body.map((t) => <p>{t}</p>)}
          {block.list && (
            <>
              {block.list.title && <h3>{block.list.title}</h3>}
              <ul class="pb-list">{block.list.items.map((it) => <li>{it}</li>)}</ul>
            </>
          )}
          {block.table && (
            <div class="table-scroll">
              <table class="data">
                <thead><tr>{block.table.head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
                <tbody>
                  {block.table.rows.map((r) => (
                    <tr><th scope="row">{r[0]}</th>{r.slice(1).map((cell) => <td>{cell}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>
    </section>
  ))}

  <!-- ============ specifications ============ -->
  {sectionKeys.includes('specTable') && (
    <section class="section section-sunken">
      <div class="wrap">
        <div class="sec-head-p">
          <p class="eyebrow">Reference</p>
          <h2>{p.name} at a specification level</h2>
        </div>
        <div class="table-scroll">
          <table class="data spec-table">
            <tbody>
              {specs.map(([k, v]) => (
                <tr><th scope="row">{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  )}

  <QuickSpec
    categorySlug={p.categorySlug}
    productName={p.name}
    variant="band"
    title={`Specify ${p.name} in under a minute`}
  />

  <!-- ============ benefits ============ -->
  <section class="section section-sunken">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{benefitsEyebrow(hc)}</p>
        <h2>{benefitsHeading(hc)}</h2>
      </div>
      <div class="grid g-4">
        {benefits.map((b) => (
          <div class="tile reveal">
            <h3 style="font-size:var(--fs-md)">{b.title}</h3>
            <p class="muted" style="font-size:var(--fs-sm);margin-top:var(--s-2)">{b.text}</p>
          </div>
        ))}
      </div>
      <p class="cat-back">
        This format sits in our <a href={cat.url}>{cat.name.toLowerCase()} range</a>, alongside
        {' '}{Math.max(0, (cat.products?.length ?? 1) - 1)} other made-to-order formats.
      </p>
    </div>
  </section>

  <Faqs faqs={faqs} title={faqHeading(hc)} intro={`Specification, minimums and lead times for ${p.name.toLowerCase()}.`} />

  <!-- ============ related ============ -->
  {related.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Related formats</p>
          <h2>{relatedHeading(hc)}</h2>
        </div>
        <div class="grid g-4">
          {related.map((r) => (
            <div class="reveal"><ProductCard product={r} showCategory /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand title={ctaHeading(hc)} text={ctaText(hc)} />
</Base>

<style>
  /* ---------- top: gallery left, quote form right ---------- */
  /* The next section brings its own top padding, so a full --s-16 here left
     roughly 160px of dead space between the gallery and the first body block. */
  .p-top { padding-block: var(--s-6) var(--s-10); }
  .p-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 430px);
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: start;
  }
  @media (max-width: 1040px) { .p-grid { grid-template-columns: 1fr; } }

  .p-eyebrow {
    font-size: var(--fs-xs); letter-spacing: var(--track-caps);
    text-transform: uppercase; color: var(--accent); margin-bottom: var(--s-4);
  }
  .p-media h1 { font-size: var(--fs-3xl); }
  .p-summary { font-size: var(--fs-md); color: var(--text-muted); max-width: 56ch; margin: var(--s-5) 0 var(--s-6); }

  /* Four facts on one row, each with room — the three-up version collided. */
  .p-facts {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-4); margin-bottom: var(--s-8);
  }
  @media (max-width: 720px) { .p-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .p-facts div { border-top: 1px solid var(--ink); padding-top: var(--s-3); }
  .p-facts dt {
    font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-faint); margin-bottom: 0.2rem;
  }
  .p-facts dd {
    margin: 0; font-size: var(--fs-sm); font-weight: 500; color: var(--ink);
    font-variant-numeric: tabular-nums; text-wrap: nowrap;
  }

  .p-panel { position: sticky; top: calc(var(--header-h) + 1.5rem); }
  @media (max-width: 1040px) { .p-panel { position: static; } }

  /* ---------- prose ---------- */
  /* Centred: left-aligned inside the 1580px wrap left ~900px of dead space to
     the right of every paragraph on all 371 product pages. */
  .p-prose { max-width: 74ch; margin-inline: auto; }
  .pb-prose { max-width: 74ch; margin-inline: auto; }
  .pb-wide { max-width: 96ch; margin-inline: auto; }
  .pb-prose h2, .pb-wide h2 { font-size: var(--fs-2xl); margin-bottom: var(--s-5); text-wrap: balance; }
  .pb-prose h3, .pb-wide h3 { font-size: var(--fs-md); margin: var(--s-6) 0 var(--s-3); }
  .pb-prose p, .pb-wide p { color: var(--text-muted); font-size: var(--fs-md); line-height: 1.65; }
  .pb-prose p + p, .pb-wide p + p { margin-top: var(--s-4); }
  .pb-list { margin-top: var(--s-5); padding-left: 1.1rem; display: grid; gap: var(--s-2); }
  .pb-list li { color: var(--text-muted); font-size: var(--fs-md); }
  .pb-wide .table-scroll { margin-top: var(--s-6); }
  .p-prose > h2:first-child { margin-top: 0; }

  /* ---------- specifications ---------- */
  .sec-head-p { border-top: 1px solid var(--ink); padding-top: var(--s-5); margin-bottom: var(--s-6); }
  .sec-head-p h2 { font-size: var(--fs-2xl); }
  /* A wide value column so entries never break to one word per line. */
  .spec-table { min-width: 640px; }
  .spec-table th[scope='row'] { width: 26%; white-space: nowrap; }
  .spec-table td { color: var(--text-muted); }

  /* ---------- configurator ---------- */
  .cfg-grid {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 1rem + 4vw, 4rem); align-items: start;
  }
  @media (max-width: 980px) { .cfg-grid { grid-template-columns: 1fr; } }
  .cfg-intro h2 { font-size: var(--fs-2xl); margin-bottom: var(--s-4); }
  .cfg-intro .lede { margin-bottom: var(--s-5); }

  .cat-back { margin-top: var(--s-8); font-size: var(--fs-sm); color: var(--text-muted); }
</style>
