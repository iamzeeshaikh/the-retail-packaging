---
/**
 * Analytics loader.
 *
 * Nothing is emitted unless a real measurement ID is set in the environment,
 * so the shipped site carries no third-party script by default and no fake IDs
 * exist anywhere in the repository.
 */
const GA4 = import.meta.env.PUBLIC_GA4_ID || 'G-BWD09PFWQE'
const GTM = import.meta.env.PUBLIC_GTM_ID
const GSC = import.meta.env.PUBLIC_GSC_VERIFICATION
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID || 'yk7d21q01g'
---
{GSC && <meta name="google-site-verification" content={GSC} />}

{CLARITY && (
  <script type="text/javascript" is:inline define:vars={{ CLARITY }}>
    (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
    })(window, document, "clarity", "script", CLARITY);
  </script>
)}

{GA4 && (
  <>
    <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA4}`}></script>
    <script is:inline define:vars={{ GA4 }}>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      window.gtag = gtag
      gtag('js', new Date())
      gtag('config', GA4, { anonymize_ip: true })
    </script>
    <script defer is:inline src="/ga4-events.js"></script>
  </>
)}

{!GA4 && GTM && (
  <script is:inline define:vars={{ GTM }}>
    ;(function (w, d, s, i) {
      w[l = 'dataLayer'] = w[l] || []
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s)
      j.async = true
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i
      f.parentNode.insertBefore(j, f)
    })(window, document, 'script', GTM)
  </script>
)}
