---
/**
 * Analytics loader.
 *
 * Nothing is emitted unless a real measurement ID is set in the environment,
 * so the shipped site carries no third-party script by default and no fake IDs
 * exist anywhere in the repository.
 */
const GA4 = import.meta.env.PUBLIC_GA4_ID || 'G-BWD09PFWQE'
const GTM = import.meta.env.PUBLIC_GTM_ID
const GSC = import.meta.env.PUBLIC_GSC_VERIFICATION
const CLARITY = import.meta.env.PUBLIC_CLARITY_ID || 'yk7d21q01g'
---
{GSC && <meta name="google-site-verification" content={GSC} />}

{(GA4 || CLARITY) && (
  <>
    {/* The queues exist at once so ga4-events.js can record clicks, but gtag.js
        and Clarity load only once the page is idle after `load`, keeping them
        off the critical path, and never for automation. */}
    <script is:inline define:vars={{ GA4, CLARITY }}>
      window.dataLayer = window.dataLayer || []
      function gtag() { dataLayer.push(arguments) }
      window.gtag = gtag
      if (GA4) { gtag('js', new Date()); gtag('config', GA4, { anonymize_ip: true }) }
      window.clarity = window.clarity || function () { (window.clarity.q = window.clarity.q || []).push(arguments) }
      ;(function () {
        function load() {
          if (navigator.webdriver) return
          var srcs = []
          if (GA4) srcs.push('https://www.googletagmanager.com/gtag/js?id=' + GA4)
          if (CLARITY) srcs.push('https://www.clarity.ms/tag/' + CLARITY)
          srcs.forEach(function (src) {
            var s = document.createElement('script'); s.async = true; s.src = src; document.head.appendChild(s)
          })
        }
        function idle() { 'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 3000 }) : setTimeout(load, 1500) }
        if (document.readyState === 'complete') idle(); else addEventListener('load', idle)
      })()
    </script>
    {GA4 && <script defer is:inline src="/ga4-events.js"></script>}
  </>
)}

{!GA4 && GTM && (
  <script is:inline define:vars={{ GTM }}>
    ;(function (w, d, s, i) {
      w[l = 'dataLayer'] = w[l] || []
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' })
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s)
      j.async = true
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i
      f.parentNode.insertBefore(j, f)
    })(window, document, 'script', GTM)
  </script>
)}
