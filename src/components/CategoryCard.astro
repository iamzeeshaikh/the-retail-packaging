---
import type { Category, Product } from '../lib/catalog'
export interface Props { category: Category; count: number; sample?: Product; loading?: 'lazy' | 'eager' }
const { category: c, count, sample, loading = 'lazy' } = Astro.props
const img = sample?.images?.[0]
---
<a class="cat" href={c.url}>
  <span class="cat-frame">
    {img ? (
      <img
        src={`${img.base}-800.webp`}
        srcset={`${img.base}-400.webp 400w, ${img.base}-800.webp 800w`}
        sizes="(max-width: 620px) 92vw, (max-width: 1024px) 45vw, 400px"
        width={img.width} height={img.height}
        loading={loading} decoding="async"
        alt={`${sample?.name} from the ${c.name.toLowerCase()} range`}
      />
    ) : <span class="ph" aria-hidden="true"></span>}
  </span>
  <span class="cat-label">
    <span class="cat-name">{c.name}</span>
    <span class="cat-n">{count}</span>
  </span>
</a>

<style>
  /* Label sits under the image. Light packaging photography swallowed white
     overlay text no matter how heavy the scrim, and a heavy scrim made the
     grid look muddy rather than premium. */
  .cat { display: block; text-decoration: none; color: inherit; }
  .cat:hover { color: inherit; }
  .cat-frame {
    display: block; position: relative; overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--paper);
    border: 1px solid var(--rule);
    transition: border-color var(--dur) var(--ease);
  }
  .cat-frame img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  .ph { display: block; width: 100%; height: 100%; background: var(--bone-deep); }
  @media (hover: hover) {
    .cat:hover .cat-frame { border-color: var(--ink); }
    .cat:hover .cat-frame img { transform: scale(1.04); }
  }
  .cat-label {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3);
    padding-top: var(--s-4); margin-top: var(--s-4);
    border-top: 1px solid var(--ink);
  }
  .cat-name {
    font-size: var(--fs-md); font-weight: 500; letter-spacing: -0.02em;
    color: var(--ink); line-height: 1.2;
  }
  .cat-n {
    font-size: var(--fs-xs); color: var(--ink-3);
    font-variant-numeric: tabular-nums; flex: none;
  }
  .cat:hover .cat-name { text-decoration: underline; text-underline-offset: 0.22em; }
</style>
