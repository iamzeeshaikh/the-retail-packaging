---
import type { Category, Product } from '../lib/catalog'
export interface Props { category: Category; count: number; sample?: Product; loading?: 'lazy' | 'eager'; tall?: boolean }
const { category: c, count, sample, loading = 'lazy', tall = false } = Astro.props
const img = sample?.images?.[0]
---
<a class={`tile-photo cat-tile${tall ? ' is-tall' : ''}`} href={c.url}>
  {img ? (
    <img
      src={`${img.base}-800.webp`}
      srcset={`${img.base}-400.webp 400w, ${img.base}-800.webp 800w`}
      sizes="(max-width: 620px) 92vw, (max-width: 1024px) 45vw, 420px"
      width={img.width} height={img.height}
      loading={loading} decoding="async"
      alt={`${sample?.name} representing the ${c.name.toLowerCase()} range`}
    />
  ) : <div class="ph" aria-hidden="true"></div>}
  <span class="tile-copy">
    <span class="k">{count} formats</span>
    <span class="t">{c.name}</span>
  </span>
</a>
<style>
  .cat-tile { aspect-ratio: 4 / 3; }
  .cat-tile.is-tall { aspect-ratio: 3 / 4; }
  .cat-tile img { width:100%; height:100%; object-fit:cover; }
  .ph { width:100%; height:100%; background:var(--bone-deep); }
  .tile-copy .t {
    display:block; margin-top:var(--s-2);
    font-family:var(--font-display); font-size:var(--fs-xl);
    line-height:1.1; letter-spacing:-0.02em; color:#fff;
  }
</style>
