---
import type { Category, Product } from '../lib/catalog'
export interface Props { category: Category; count: number; sample?: Product; loading?: 'lazy' | 'eager' }
const { category: c, count, sample, loading = 'lazy' } = Astro.props
const img = sample?.images?.[0]
---
<article class="card card-hover">
  <a class="card-link" href={c.url}>
    <div class="card-media">
      {img ? (
        <img
          src={`${img.base}-400.webp`}
          srcset={`${img.base}-400.webp 400w, ${img.base}-800.webp 800w`}
          sizes="(max-width: 620px) 92vw, (max-width: 1024px) 45vw, 300px"
          width={img.width} height={img.height}
          loading={loading} decoding="async"
          alt={`${sample?.name} representing the ${c.name.toLowerCase()} range`}
        />
      ) : <div class="ph" aria-hidden="true"></div>}
      <span class="pill">{count} formats</span>
    </div>
    <div class="card-body">
      <h3 class="card-title">{c.name}</h3>
      <span class="card-foot">
        See the range
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"/></svg>
      </span>
    </div>
  </a>
</article>

<style>
  .card-media { aspect-ratio: 3 / 2; }
  .pill { position: absolute; left: var(--s-3); top: var(--s-3); background: rgba(20,22,26,.78);
    color: #fff; font-size: 0.6875rem; font-weight: 600; letter-spacing: .03em;
    padding: .28rem .6rem; border-radius: var(--r-pill); backdrop-filter: blur(4px); }
  .ph { height: 100%; background: var(--ivory-deep); }
</style>
