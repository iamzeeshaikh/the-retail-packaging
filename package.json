{
  "name": "the-retail-packaging",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check --minimumSeverity error",
    "catalog": "python3 scripts/build-catalog.py",
    "images": "node scripts/process-images.mjs",
    "images:force": "node scripts/process-images.mjs --force",
    "qa": "node scripts/qa.mjs",
    "verify": "npm run check && npm run build && npm run qa"
  },
  "dependencies": {
    "astro": "^7.2.0",
    "busboy": "^1.6.0",
    "nodemailer": "^9.0.5",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
